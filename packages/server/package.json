    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@derby/core": "0.2.0",
    "@fastify/static": "^8.0.0",
    "@fastify/websocket": "^11.0.0",
    "adm-zip": "^0.6.1",
    "fastify": "^5.0.0",
    "ffmpeg-static": "^5.3.0",
    "node-forge": "^1.4.0",
    "serialport": "^13.0.0",
    "tsx": "^4.19.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node-forge": "^1.3.14",
    "@types/ws": "^8.5.0"
  }
}
